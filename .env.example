# ========================================================
# Expense Voucher Management System - Environment Variables
# ========================================================

# Server Port (Default: 3000)
PORT=3000

# Application Host URL 
APP_URL="MY_APP_URL"

# JWT Secret Key: Used to cryptographically sign and verify user authentication tokens
JWT_SECRET="your-super-secret-jwt-signing-key"

# MySQL Database Configuration 
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="expense_voucher_db"

# Optional Gemini API Key 
GEMINI_API_KEY="MY_GEMINI_API_KEY"
